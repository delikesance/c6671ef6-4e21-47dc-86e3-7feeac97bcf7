  "@bdfd_docs_desc_and": {
    "description": "Logical AND Ã¢â‚¬â€ combines multiple conditions. All must be true.\n\nUsage: $if[$and[$authorID==123;$hasRole[456]]]"
  },
  "@bdfd_docs_desc_awaitfunc": {
    "description": "Registers a callback that waits for a user response.\n\nUsage: $awaitFunc[name;userID (opt);channelID (opt)]\n\nThe awaited function is stored and triggered when the target user sends a message in the target channel."
  },
  "@bdfd_docs_desc_callworkflow": {
    "description": "Bot Creator only Ã¢â‚¬â€ Calls another workflow by name and passes arguments.\n\nSyntax: $callWorkflow[myWorkflow;key1=value1;key2=value2]\n\nThe called workflow can read arguments and return a value via $workflowResponse."
  },
  "@bdfd_docs_desc_defer": {
    "description": "Defers the interaction response, giving you more time to process. The user sees a \"Bot is thinkingÃ¢â‚¬Â¦\" message. Use before long operations like HTTP requests."
  },
  "@bdfd_docs_desc_elseif": {
    "description": "Adds an alternative condition inside an $if block. Must appear between $if and $else/$endif."
  },
  "@bdfd_docs_desc_embedsuppresserrors": {
    "description": "Same as $suppressErrors Ã¢â‚¬â€ suppresses all error messages silently."
  },
  "@bdfd_docs_desc_ephemeral": {
    "description": "Makes the response visible only to the user who triggered the command. Must be placed before any response content."
  },
  "@bdfd_docs_desc_eval": {
    "description": "Executes a BDFD script string at runtime. The code passed as argument is re-compiled and executed dynamically. Useful for running user-provided or variable-based scripts."
  },
  "@bdfd_docs_desc_for": {
    "description": "Bot Creator only Ã¢â‚¬â€ Repeats a block of code N times.\n\nSimple: $for[5]...$endfor Ã¢â€ â€™ the body is repeated 5 times (max 100). You can use $i for the current index (starting at 0) and $loopCount for the total.\n\nC-style: $for[i=0;i<10;i++]...$endfor Ã¢â€ â€™ classic for loop with init, condition and update. Supports ++, --, +=, -=, *=.\n\nIf the iteration count is dynamic (e.g. $for[$args[1]]), the loop runs at runtime instead of compile-time."
  },
  "@bdfd_docs_desc_httpaddheader": {
    "description": "Adds a header to the next HTTP request. Headers are accumulated until the next $httpGet/$httpPost/etc.\n\nUsage: $httpAddHeader[Authorization;Bearer token123]"
  },
  "@bdfd_docs_desc_httpget": {
    "description": "Sends an HTTP GET request to the given URL. Use $httpAddHeader before to set headers. Use $httpResult to read the response.\n\nAll HTTP methods (GET, POST, PUT, PATCH, DELETE) follow the same pattern."
  },
  "@bdfd_docs_desc_httpresult": {
    "description": "Returns the body of the last HTTP response. Optionally pass a JSON path to extract a specific field.\n\nUsage: $httpResult[] for the full body, or $httpResult[data.name] for a nested field."
  },
  "@bdfd_docs_desc_if": {
    "description": "Conditional block. Supports nesting and rich operators: ==, !=, >=, <=, >, <, contains, startsWith, endsWith, notContains.\n\nUsage:\n$if[$authorID==123456]\n  Hello admin!\n$elseif[$hasRole[789]]\n  Hello member!\n$else\n  Hello guest!\n$endif"
  },
  "@bdfd_docs_desc_jsonparse": {
    "description": "Parses a JSON string into memory for manipulation. All JSON operations ($jsonSet, $json, etc.) operate on this parsed context.\n\nStatic JSON is resolved at compile-time for better performance."
  },
  "@bdfd_docs_desc_jsonset": {
    "description": "Sets a value in the current JSON context. Supports dot-notation paths.\n\nUsage: $jsonSet[user.name;John]\n\nThe change is applied in memory Ã¢â‚¬â€ use $jsonStringify to get the result."
  },
  "@bdfd_docs_desc_jsonstringify": {
    "description": "Converts the current JSON context back to a string. Use after $jsonParse and $jsonSet operations to output the result."
  },
  "@bdfd_docs_desc_loop": {
    "description": "Bot Creator only Ã¢â‚¬â€ Alias for $for. See $for for details. Use $endloop to close the block."
  },
  "@bdfd_docs_desc_or": {
    "description": "Logical OR Ã¢â‚¬â€ combines multiple conditions. At least one must be true.\n\nUsage: $if[$or[$authorID==123;$authorID==456]]]"
  },
  "@bdfd_docs_desc_stop": {
    "description": "Immediately stops execution of the current script. No further actions after $stop will run."
  },
  "@bdfd_docs_desc_suppresserrors": {
    "description": "Prevents error messages from being sent to the user. If any action fails, the error is silently suppressed."
  },
  "@bdfd_docs_desc_try": {
    "description": "Wraps a block for error handling.\n\nUsage:\n$try\n  $httpGet[https://api.example.com/data]\n$catch\n  Request failed!\n$endtry\n\nIf any function in the $try block fails, execution jumps to $catch."
  },
  "@bdfd_docs_desc_workflowresponse": {
    "description": "Bot Creator only Ã¢â‚¬â€ Returns the response from the last $callWorkflow.\n\nUse $workflowResponse[] for the full response, or $workflowResponse[property] to access a specific field."
  },
